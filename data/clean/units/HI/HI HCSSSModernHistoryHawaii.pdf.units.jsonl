{"page": 3, "kind": "cell", "table": 1, "row": 14, "col": 2, "x": null, "text": "Effects of the Overthrow", "id": "u52", "furniture": false}
{"page": 3, "kind": "cell", "table": 1, "row": 14, "col": 3, "x": null, "text": "Content Standard SS.MHH.1.19.2 Analyze the political issues that emerged from the overthrow of the Hawaiian monarchy", "id": "u53", "furniture": false}
{"page": 3, "kind": "cell", "table": 1, "row": 14, "col": 4, "x": null, "text": "• Political Effects: Provisional Government, Republic of Hawaiʻi, Wilcox rebellion, Territorial government, failed annexation treaties (1893, 1897), Hui Aloha Aina petitions, Newlands Joint Resolution of Congress (1898)", "id": "u54", "furniture": false}
{"page": 3, "kind": "cell", "table": 1, "row": 15, "col": 1, "x": null, "text": "Anchor Standard 19", "id": "u55", "furniture": false}
